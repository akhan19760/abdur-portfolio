  "study": {
    "principles": [
      {
        "title": "One loud face, used huge",
        "text": "The display face runs at 88 to 96px; everything else is one quiet face at 16 to 18px."
      },
      {
        "title": "Three colours, held to",
        "text": "A ground, an ink and one accent. The accent marks the one action on each screen."
      },
      {
        "title": "Colour in whole blocks",
        "text": "A section or the footer turns solid accent, instead of small coloured details everywhere."
      },
      {
        "title": "The work, big",
        "text": "Each project gets most of a screen with its result in plain words, never a row of thumbnails."
      },
      {
        "title": "One move per section",
        "text": "A single choreographed moment per section; the rest of the section stays still."
      },
      {
        "title": "A finale footer",
        "text": "Both end on the name or a sign-off line, not on a list of links."
      }
    ],
    "avoid": [
      "Small labels above every heading",
      "Gradients, glows and soft shadows behind text",
      "Rows of identical project cards",
      "A headline longer than two lines at phone width"
    ]
  },
  "sections": ["about", "work", "contact"],
